# Copy to .env.local and fill in. Never commit real values.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
# trace | debug | info | warn | error | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Supabase (https://supabase.com/dashboard/project/_/settings/api)
# Local: `supabase start` prints these values.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket used by lib/storage for generated media.
SUPABASE_STORAGE_BUCKET=media

# ---------------------------------------------------------------------------
# YouTube Data API v3 (https://console.cloud.google.com/apis/credentials)
# Default quota is 10,000 units/day. search.list costs 100 units, most list calls cost 1.
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_REQUEST_TIMEOUT_MS=10000
YOUTUBE_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# API v1 access
# Bearer token required on /api/v1/* until per-workspace API keys ship.
# Required in production; if blank in development, v1 routes are open locally.
# ---------------------------------------------------------------------------
INTERNAL_API_KEY=

# Secret for /api/cron/tick (GitHub Actions sends it). Generate a long random string.
CRON_SECRET=

# Comma-separated emails allowed to use the app. Blank = any account created in Supabase Auth.
# People invited from the waitlist are always allowed.
ALLOWED_EMAILS=

# Comma-separated emails that can manage the waitlist at /admin/waitlist.
ADMIN_EMAILS=

# Public URL used in invite links, e.g. https://outlier.vercel.app (defaults to the request origin).
SITE_URL=

# Discord invite shown on the landing page, e.g. https://discord.gg/abc123
DISCORD_INVITE_URL=

# ---------------------------------------------------------------------------
# Background jobs (Postgres-backed queue — no Redis)
# ---------------------------------------------------------------------------
JOB_WORKER_POLL_INTERVAL_MS=2000
JOB_WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Storage budget & auto-sync
# How much room the database may take (the box's disk, or a managed plan's
# limit), and the point where ingestion pauses. Defaults suit the production
# server's 193 GB disk; lower them for a small managed plan.
# ---------------------------------------------------------------------------
SUPABASE_PLAN_LIMIT_MB=180000
STORAGE_BUDGET_MB=150000
SYNC_INTERVAL_HOURS=24
SYNC_MAX_CHANNELS_PER_RUN=50
SNAPSHOT_VIDEO_MAX_AGE_DAYS=90
SNAPSHOT_DAILY_RETENTION_DAYS=30
SNAPSHOT_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# AI providers (optional). See niche labeling below for GEMINI_API_KEY (free) and ANTHROPIC_API_KEY.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Error monitoring (Sentry, optional). Monitoring is off until a DSN is set.
# ---------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps during builds:
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---------------------------------------------------------------------------
# Outlier quality rules (Trending Today + Discovery)
# ---------------------------------------------------------------------------
OUTLIER_LANGUAGE=en
OUTLIER_REGION=US
OUTLIER_COUNTRIES=US,GB,CA,AU,NZ,IE
OUTLIER_MIN_VIEWS=100000
OUTLIER_MAX_SUBSCRIBERS=100000
OUTLIER_MIN_VIEWS_PER_SUB=10
OUTLIER_MIN_ENGAGEMENT=0.01
# Trending picks must have at least this many times their channel's median Short views.
OUTLIER_MIN_MULTIPLIER=2

# --- YouTube quota & caching -------------------------------------------------
# Daily quota for the API key (Google's default is 10,000 units; resets midnight Pacific).
YOUTUBE_DAILY_QUOTA=10000
# Units background jobs can never use (kept for user-triggered requests).
YOUTUBE_USER_RESERVE_UNITS=3000
# Units nobody spends (headroom for retries).
YOUTUBE_SAFETY_BUFFER_UNITS=300
# Per-user daily units on the default tier (the "pro" tier gets 3x).
YOUTUBE_USER_DAILY_UNITS=1000
YOUTUBE_QUOTA_ENFORCED=true
YOUTUBE_CACHE_ENABLED=true
# Monitoring batch sizes per hourly run (1 unit per 50 items).
MONITOR_MAX_VIDEOS_PER_RUN=2000
MONITOR_MAX_CHANNELS_PER_RUN=1000

# Salt for hashing IPs/emails in rate-limit keys (defaults to CRON_SECRET).
RATE_LIMIT_SALT=

# --- Credits & referrals -----------------------------------------------------
# Credits per user per UTC month (bonus credits from referrals are added on top).
MONTHLY_CREDITS=400
# Bonus credits when a referred friend creates an account: for the referrer, then for the friend.
REFERRAL_REFERRER_CREDITS=25
REFERRAL_REFERRED_CREDITS=50
# Extra bonus at "friends:credits" milestones; the last one repeats forever.
# Running totals with the per-friend bonus: 100 / 250 / 500 / 1000 credits.
REFERRAL_MILESTONES=1:75,3:100,5:200,10:375
# Waitlist referrals needed for priority access.
REFERRAL_PRIORITY_THRESHOLD=3
# Cap on referral rewards per referrer per month.
REFERRAL_MAX_REWARDS_PER_MONTH=20

# --- Niche labeling & library growth -----------------------------------------
# Labels every channel with a category, its game or topic, and sub-niches. Free: rules, no key needed.
# Channels the rules are unsure about get an AI second opinion when a key is set:
#   GEMINI_API_KEY    free tier from Google AI Studio (aistudio.google.com). Free-tier inputs may be used by Google.
#   ANTHROPIC_API_KEY Claude, paid.
# NICHE_LABEL_PROVIDER: auto (Gemini, then Claude, then rules) | gemini | anthropic | rules
NICHE_LABEL_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
NICHE_LABEL_MODEL=claude-opus-5
NICHE_LABEL_BATCH_SIZE=20
NICHE_LABEL_MAX_PER_RUN=200
# Library growth runs every 6h in the background quota lane.
# Featured channels: creators featured on labeled channels' pages (1 unit per channel checked).
LIBRARY_FEATURED_CHECKS_PER_RUN=60
LIBRARY_FEATURED_NEW_PER_RUN=80
LIBRARY_FEATURED_MAX_SUBSCRIBERS=1000000
# Seed searches for niches the library is thin on (100-300 units each). 0 = off.
LIBRARY_GROWTH_SEARCHES_PER_RUN=3
LIBRARY_GROWTH_DAILY_SEARCHES=12
LIBRARY_GROWTH_RESEED_DAYS=14

# --- InnerTube scraper (optional; see README) -------------------------------
# One global queue, rate limit, cache, and circuit breaker for all scraped reads.
INNERTUBE_REQUESTS_PER_MINUTE=4
INNERTUBE_MAX_CONCURRENT=1
INNERTUBE_MAX_RETRIES=2
INNERTUBE_FAILURE_THRESHOLD=5
INNERTUBE_BREAKER_MINUTES=30
INNERTUBE_MAX_BREAKER_HOURS=12
INNERTUBE_CACHE_TTL_SECONDS=1800
INNERTUBE_MAX_VIDEOS=30
# Interactive reads (searches): their own allowance, ahead of the scraper's queue.
INNERTUBE_USER_REQUESTS_PER_MINUTE=30
INNERTUBE_USER_MAX_WAIT_MS=2000
# Run searches on the web endpoints (free) instead of search.list (100 units).
INNERTUBE_SEARCH_ENABLED=true
# Rate ladder: one clean day earns the next step; a block settles one rung below
# the rate YouTube refused. A single value pins the rate.
INNERTUBE_RAMP_STEPS=4,6,9,12,16,20,25
INNERTUBE_RAMP_CLEAN_HOURS=24
# How long a frozen ladder waits, block-free, before probing upward again.
INNERTUBE_RAMP_THAW_HOURS=72
# Where the ladder position is remembered (systemd sets STATE_DIRECTORY instead).
INNERTUBE_STATE_DIR=.
# Channels the scraper picks per round.
SCRAPER_BATCH=20
