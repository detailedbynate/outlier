# Copy to .env.local and fill in. Never commit real values.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
# trace | debug | info | warn | error | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Supabase (https://supabase.com/dashboard/project/_/settings/api)
# Local: `supabase start` prints these values.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket used by lib/storage for generated media.
SUPABASE_STORAGE_BUCKET=media

# ---------------------------------------------------------------------------
# YouTube Data API v3 (https://console.cloud.google.com/apis/credentials)
# Default quota is 10,000 units/day. search.list costs 100 units, most list calls cost 1.
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_REQUEST_TIMEOUT_MS=10000
YOUTUBE_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# API v1 access
# Bearer token required on /api/v1/* until per-workspace API keys ship.
# Required in production; if blank in development, v1 routes are open locally.
# ---------------------------------------------------------------------------
INTERNAL_API_KEY=

# Secret for /api/cron/tick (GitHub Actions sends it). Generate a long random string.
CRON_SECRET=

# Comma-separated emails allowed to use the app. Blank = any account created in Supabase Auth.
# People invited from the waitlist are always allowed.
ALLOWED_EMAILS=

# Comma-separated emails that can manage the waitlist at /admin/waitlist.
ADMIN_EMAILS=

# Public URL used in invite links, e.g. https://outlier.vercel.app (defaults to the request origin).
SITE_URL=

# Discord invite shown on the landing page, e.g. https://discord.gg/abc123
DISCORD_INVITE_URL=

# ---------------------------------------------------------------------------
# Background jobs (Postgres-backed queue — no Redis)
# ---------------------------------------------------------------------------
JOB_WORKER_POLL_INTERVAL_MS=2000
JOB_WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Storage budget & auto-sync
# Ingestion pauses once the database reaches STORAGE_BUDGET_MB (default: half
# of the 500 MB free plan), leaving plenty of headroom.
# ---------------------------------------------------------------------------
SUPABASE_PLAN_LIMIT_MB=500
STORAGE_BUDGET_MB=250
SYNC_INTERVAL_HOURS=24
SYNC_MAX_CHANNELS_PER_RUN=50
SNAPSHOT_VIDEO_MAX_AGE_DAYS=90
SNAPSHOT_DAILY_RETENTION_DAYS=30
SNAPSHOT_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# AI providers (optional — not wired up yet; abstractions live in lib/ai)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
